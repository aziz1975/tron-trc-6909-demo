# Copy this file to .env. Use a dedicated Nile testnet wallet.
# Private key: 64 hexadecimal characters, without the 0x prefix.
# Never commit .env or share the private key.
PRIVATE_KEY_NILE=
# A different Nile wallet, funded with test TRX, signs delegated transfers.
PRIVATE_KEY_NILE_SPENDER=
# Existing GameItems contract on Nile (public address).
CONTRACT_ADDRESS_NILE=
